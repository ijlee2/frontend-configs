{
  "name": "@ijlee2-frontend-configs/eslint-config-node",
  "version": "4.10.0",
  "description": "Configuration for eslint (Node)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/frontend-configs.git",
    "directory": "packages/eslint/node"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./javascript": "./dist/javascript.js",
    "./typescript": "./dist/typescript.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "./build.sh",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  },
  "devDependencies": {
    "@ijlee2-frontend-configs/prettier": "workspace:*",
    "@ijlee2-frontend-configs/typescript": "workspace:*",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.15.0",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": false
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": "22.* || >= 24"
  }
}
