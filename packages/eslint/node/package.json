{
  "name": "@ijlee2-frontend-configs/eslint-config-node",
  "version": "4.1.1",
  "description": "Configuration for eslint (Node)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/frontend-configs.git",
    "directory": "packages/eslint/node"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./javascript": "./javascript/index.mjs",
    "./typescript": "./typescript/index.mjs"
  },
  "scripts": {
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.64.0"
  },
  "devDependencies": {
    "@ijlee2-frontend-configs/prettier": "workspace:*",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5"
  },
  "peerDependencies": {
    "eslint": "^10.7.0",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": false
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": "22.* || >= 24"
  }
}
