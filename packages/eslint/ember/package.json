{
  "name": "@ijlee2-frontend-configs/eslint-config-ember",
  "version": "4.2.0",
  "description": "Configuration for eslint (Ember)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/frontend-configs.git",
    "directory": "packages/eslint/ember"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./v1-addon": "./v1-addon/index.mjs",
    "./v1-app": "./v1-app/index.mjs",
    "./v2-addon": "./v2-addon/index.mjs",
    "./v2-app": "./v2-app/index.mjs"
  },
  "scripts": {
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-ember": "^13.5.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-qunit": "^8.2.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.9.0",
    "typescript-eslint": "^8.67.0"
  },
  "devDependencies": {
    "@ijlee2-frontend-configs/eslint-config-node": "workspace:*",
    "@ijlee2-frontend-configs/prettier": "workspace:*",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6"
  },
  "peerDependencies": {
    "eslint": "^10.8.1",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": false
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": "22.* || >= 24"
  }
}
