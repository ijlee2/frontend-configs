{
  "name": "@ijlee2-frontend-configs/eslint-config-ember",
  "version": "4.7.0",
  "description": "Configuration for eslint (Ember)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/frontend-configs.git",
    "directory": "packages/eslint/ember"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./v1-addon": "./dist/v1-addon.js",
    "./v1-app": "./dist/v1-app.js",
    "./v2-addon": "./dist/v2-addon.js",
    "./v2-app": "./dist/v2-app.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "./build.sh",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-ember": "^13.6.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-qunit": "^8.2.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  },
  "devDependencies": {
    "@ijlee2-frontend-configs/eslint-config-node": "workspace:*",
    "@ijlee2-frontend-configs/prettier": "workspace:*",
    "@ijlee2-frontend-configs/typescript": "workspace:*",
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.12.0",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": false
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": "22.* || >= 24"
  }
}
