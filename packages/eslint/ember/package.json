{
  "name": "@ijlee2-frontend-configs/eslint-config-ember",
  "version": "3.4.3",
  "description": "Configuration for eslint (Ember)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/frontend-configs.git",
    "directory": "packages/eslint/ember"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./v1-addon": "./v1-addon/index.mjs",
    "./v1-app": "./v1-app/index.mjs",
    "./v2-addon": "./v2-addon/index.mjs",
    "./v2-app": "./v2-app/index.mjs"
  },
  "scripts": {
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@eslint/js": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-ember": "^13.3.2",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-qunit": "^8.2.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sort-class-members": "^1.22.1",
    "eslint-plugin-typescript-sort-keys": "^3.3.0",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.60.0"
  },
  "devDependencies": {
    "@ijlee2-frontend-configs/eslint-config-node": "workspace:*",
    "@ijlee2-frontend-configs/prettier": "workspace:*",
    "concurrently": "^10.0.1",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3"
  },
  "peerDependencies": {
    "eslint": "^9.39.4",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": false
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": "22.* || >= 24"
  }
}
