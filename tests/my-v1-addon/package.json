{
  "name": "my-v1-addon",
  "version": "1.3.4",
  "private": true,
  "description": "A v1 addon for testing @ijlee2-frontend-configs",
  "keywords": [
    "ember-addon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/frontend-configs.git"
  },
  "license": "MIT",
  "author": "Isaac J. Lee",
  "typesVersions": {
    "*": {
      "test-support": [
        "declarations/addon-test-support/index.d.ts"
      ],
      "test-support/*": [
        "declarations/addon-test-support/*",
        "declarations/addon-test-support/*/index.d.ts"
      ],
      "*": [
        "declarations/addon/*",
        "declarations/addon/*/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "ember build --environment=production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --cache",
    "lint:css:fix": "stylelint \"**/*.css\" --allow-empty-input --fix",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "prelint:types": "type-css-modules --src addon",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "tsc --project tsconfig.build.json",
    "start": "ember serve",
    "test": "ember test --test-port 0"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "ember-auto-import": "^2.13.1",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-intl": "^9.0.0-beta.3"
  },
  "devDependencies": {
    "@ember-intl/v1-compat": "^2.0.0-beta.3",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.4.3",
    "@embroider/test-setup": "^4.0.0",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@glint/ember-tsc": "^1.10.0",
    "@glint/template": "^1.8.0",
    "@ijlee2-frontend-configs/ember-template-lint": "workspace:*",
    "@ijlee2-frontend-configs/eslint-config-ember": "workspace:*",
    "@ijlee2-frontend-configs/prettier": "workspace:*",
    "@ijlee2-frontend-configs/stylelint": "workspace:*",
    "@ijlee2-frontend-configs/typescript": "workspace:*",
    "@types/qunit": "^2.19.14",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^10.0.4",
    "ember-cli": "~6.12.0",
    "ember-cli-clean-css": "^3.0.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-load-initializers": "^3.0.1",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~6.12.0",
    "ember-template-lint": "^7.9.3",
    "ember-test-selectors": "^7.1.0",
    "eslint": "^10.8.1",
    "loader.js": "^4.7.0",
    "prettier": "^3.9.6",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "stylelint": "^17.14.1",
    "type-css-modules": "^3.2.10",
    "typescript": "^6.0.3",
    "webpack": "^5.109.2"
  },
  "engines": {
    "node": "22.* || >= 24"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config"
  }
}
