{
  "extends": "@ijlee2-frontend-configs/typescript/ember-app",
  "compilerOptions": {
    "paths": {
      "my-v2-app/tests/*": ["./tests/*"],
      "my-v2-app/*": ["./app/*"],
      "*": ["./types/*"]
    },
    "rootDir": ".",
    "types": ["@glint/ember-tsc/types", "@types/qunit", "ember-source/types"]
  },
  "include": ["app/**/*", "tests/**/*", "types/**/*"]
}
